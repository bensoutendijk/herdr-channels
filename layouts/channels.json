{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "sidebar-head",
          "type": "block",
          "content": {
            "mod": "channels",
            "props": {
              "head": true
            }
          },
          "size": {
            "px": 52
          },
          "window_drag": true
        },
        {
          "id": "sidebar-list",
          "type": "block",
          "content": {
            "mod": "channels"
          },
          "size": {
            "weight": 1
          },
          "min": 140
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "spaces"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "sidebar-foot",
          "type": "block",
          "content": {
            "mod": "channels",
            "props": {
              "foot": true
            }
          },
          "size": {
            "px": 44
          }
        }
      ],
      "size": {
        "px": 280
      },
      "min": 180,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "space-tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 52
          },
          "hidden": true,
          "window_drag": true
        },
        {
          "id": "bar",
          "type": "block",
          "content": {
            "mod": "channels",
            "props": {
              "bar": true
            }
          },
          "size": {
            "px": 52
          },
          "window_drag": true
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 6,
              "radius": 6,
              "border": {
                "width": 1,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              }
            }
          }
        }
      ],
      "resizable": false
    },
    {
      "id": "panel",
      "type": "column",
      "hidden": true,
      "size": {
        "px": 368
      },
      "min": 280,
      "max": 900,
      "children": [
        {
          "id": "panel-body",
          "type": "stack",
          "active": "files",
          "children": [
            {
              "id": "files",
              "type": "block",
              "content": {
                "mod": "files"
              }
            },
            {
              "id": "changes",
              "type": "block",
              "content": {
                "mod": "changes"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tasks-panel",
      "type": "stack",
      "children": [
        {
          "id": "tasks",
          "type": "block",
          "content": {
            "mod": "channels",
            "props": {
              "panel": true
            }
          }
        }
      ],
      "active": "tasks",
      "size": {
        "px": 560
      },
      "min": 300,
      "max": 1100
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    16
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    16,
    19
  ]
}
